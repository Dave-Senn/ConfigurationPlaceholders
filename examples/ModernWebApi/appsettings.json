{
  "AppOptions": {
    "InputFile": "C:/NotExisting/input{FileExtension}",
    "MinLengthString": "{FileExtension}"
  },
  "_urls": "http://*:${Port}",
  "urls": "http://*:5003",
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug"
    }
  },
  "AllowedHosts": "*",
  "CertificateSubject": "${FQDN}${MissingPlaceholder}"
}